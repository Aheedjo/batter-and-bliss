generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite database file path is relative to the prisma/ folder (e.g. prisma/dev.db).

model Topping {
  id        String   @id @default(cuid())
  name      String
  /// glazing | topping | syrup | drink — matches in-store menu sections
  category  String   @default("topping")
  price     Float?
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Extra {
  id        String   @id @default(cuid())
  name      String
  price     Float?
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
