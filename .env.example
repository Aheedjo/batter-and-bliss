# --- Database (PostgreSQL) ---
# Neon: use the *pooler* host (…-pooler…) in DATABASE_URL for the app.
# Prisma + transaction pooler: add &sslmode=require&pgbouncer=true (see Neon + Prisma docs).
# Optional separate DIRECT_URL (non-pooler) if you wire `directUrl` in schema for migrations.
# `lib/db.ts` appends pool_timeout / connect_timeout when missing to reduce dev pool timeouts.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# First time on an empty database:
#   npx prisma migrate deploy
#   npx prisma db seed

# --- Admin (/admin) — login page at /admin/login ---
# If no admin password is set, /admin stays open (dev only). Set a strong password for real use.
# ADMIN_USER=admin
# ADMIN_PASSWORD=your-long-random-password
# Legacy (still read if ADMIN_PASSWORD / ADMIN_USER are unset): ADMIN_BASIC_AUTH_PASSWORD, ADMIN_BASIC_AUTH_USER
# Optional extra secret material for session tokens (defaults work without it):
# ADMIN_JWT_PEPPER=

# --- Bank (checkout & track). NEXT_PUBLIC_* is exposed to the browser. ---
# NEXT_PUBLIC_BANK_NAME="Access Bank"
# NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="0123456789"
# NEXT_PUBLIC_BANK_ACCOUNT_NAME="Batter & Bliss"

# --- Optional: Google Places ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_PLACES_COUNTRY=ng

# --- Menu photos (admin upload) ---
# Production: create a Blob store in Vercel → Storage, then add the read/write token.
# Local dev works without this (files go to public/uploads/menu/).
# BLOB_READ_WRITE_TOKEN=
