# SQLite file is created next to prisma/schema.prisma (e.g. prisma/dev.db).
DATABASE_URL="file:./dev.db"

# Bank transfer (shown on checkout & track). NEXT_PUBLIC_* is exposed to the browser.
# In `next dev`, if these are unset, a built-in test account (0123456789) is shown.
# For production, set real values (remove any demo copy).
# NEXT_PUBLIC_BANK_NAME="Access Bank"
# NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="0123456789"
# NEXT_PUBLIC_BANK_ACCOUNT_NAME="Batter & Bliss"

# Optional: protect /admin/* with HTTP Basic Auth (set BOTH in production).
# Use a long random password; never commit real values.
# ADMIN_BASIC_AUTH_USER=admin
# ADMIN_BASIC_AUTH_PASSWORD=
